<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon host screen, LANDSCAPE (TV / phone rotated — the Shield's native
    orientation). Ported from the desktop's wide layout: wordmark + subtitle +
    vertical pill rail on the left, host list filling the rest.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ground"
    tools:context=".PcView" >

    <!-- Left rail: branding + actions, like the desktop's left column. -->
    <LinearLayout
        android:id="@+id/am_rail"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingLeft="18dp"
        android:paddingEnd="10dp"
        android:paddingRight="10dp"
        android:paddingTop="18dp">

                <ImageView
            android:id="@+id/am_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/am_brand"
            android:scaleType="fitCenter" />

<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_wordmark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/am_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/am_tagline"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/am_text_secondary" />
    </LinearLayout>

    <!-- Host picker row: PgUp / selected host / + Add a host / PgDn -->
    <LinearLayout
        android:id="@+id/am_picker_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/am_rail"
        android:layout_toRightOf="@+id/am_rail"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/am_pg_up"
            android:clickable="true"
            android:focusable="true"
            android:text="PgUp"
            android:textSize="11sp"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_picker_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/am_picker_host_pill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_picker_pill_sel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/manuallyAddPcText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_picker_add"
            android:textSize="12sp"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_picker_pill_sel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/am_pg_dn"
            android:clickable="true"
            android:focusable="true"
            android:text="PgDn"
            android:textSize="11sp"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_picker_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_toEndOf="@+id/am_rail"
        android:layout_toRightOf="@+id/am_rail"
        android:layout_below="@+id/am_picker_row"
        android:layout_above="@+id/am_footer" >

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/am_accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/am_text_secondary"
                android:text="@string/searching_pc"/>
        </RelativeLayout>

    </RelativeLayout>

    <!-- Footer keycaps: P Shutdown / S Settings / Esc Exit -->
    <LinearLayout
        android:id="@+id/am_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/am_rail"
        android:layout_toRightOf="@+id/am_rail"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

                <TextView
            android:id="@+id/am_footer_kb_shutdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_footer_key_p"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/am_on_accent"
            android:background="@drawable/am_footer_key"
            android:paddingStart="9dp"
            android:paddingLeft="9dp"
            android:paddingEnd="9dp"
            android:paddingRight="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:visibility="gone" />

<TextView
            android:id="@+id/am_footer_shutdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_footer_shutdown"
            android:textSize="11sp"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_footer_key"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp" />

                <TextView
            android:id="@+id/am_footer_kb_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_footer_key_s"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/am_on_accent"
            android:background="@drawable/am_footer_key"
            android:paddingStart="9dp"
            android:paddingLeft="9dp"
            android:paddingEnd="9dp"
            android:paddingRight="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:visibility="gone" />

<TextView
            android:id="@+id/am_footer_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_footer_settings"
            android:textSize="11sp"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_footer_key"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp" />

                <TextView
            android:id="@+id/am_footer_kb_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_footer_key_esc"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/am_on_accent"
            android:background="@drawable/am_footer_key"
            android:paddingStart="9dp"
            android:paddingLeft="9dp"
            android:paddingEnd="9dp"
            android:paddingRight="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:visibility="gone" />

<TextView
            android:id="@+id/am_footer_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_footer_exit"
            android:textSize="11sp"
            android:textColor="@color/am_text_secondary"
            android:background="@drawable/am_footer_key"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

</RelativeLayout>
