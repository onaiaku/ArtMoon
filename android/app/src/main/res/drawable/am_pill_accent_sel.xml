<?xml version="1.0" encoding="utf-8"?>
<!-- Primary pill with desktop FocusFrame ring when focused/selected. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/am_ripple">
    <item>
            <selector>
                <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/am_accent_hi" />
                    <corners android:radius="28dp" />
                    <stroke android:width="3dp" android:color="#FF3D7BFF" />
                </shape>
                </item>
                <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/am_accent_hi" />
                    <corners android:radius="28dp" />
                    <stroke android:width="3dp" android:color="#FF3D7BFF" />
                </shape>
                </item>
                <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/am_accent_hi" />
                    <corners android:radius="28dp" />
                </shape>
                </item>
            </selector>
    </item>
</ripple>
