<?xml version="1.0" encoding="utf-8"?>
<!-- Veil drawn over the ambient cover art (desktop CoverAmbient's dithered gradient):
     a soft dark wash, deepest at the very top and very bottom, most open in the
     middle band where the master list sits. Pure gradient - no solid fill. -->
