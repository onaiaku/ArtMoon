<?xml version="1.0" encoding="utf-8"?>
<!-- Veil drawn over the ambient cover art (desktop CoverAmbient's dithered gradient):
     a soft dark wash, most open in the middle band where the master list sits,
     deepest at the foot so the artwork never ends on a hard line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1405080A"
        android:centerColor="#2E05080A"
        android:endColor="#8F05080A" />
</shape>