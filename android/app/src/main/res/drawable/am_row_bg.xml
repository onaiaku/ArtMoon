<?xml version="1.0" encoding="utf-8"?>
<!--
    The row's two levels of light, and the reason they are two.

    Selected is not the same as focused: a dialog opening on top of the page takes the focus away
    while the spotlight still shows the selected game. So the row under the cursor keeps a quiet
    fill, and it only lights to the accent — fill and border together, never the border first —
    when the list itself has focus.

    The border width is drawn by the stroke inset rather than a layout change, so a row does not
    shift a pixel when it lights up.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/am_accent_16" />
            <stroke android:width="2dp" android:color="@color/am_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="@color/am_line" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
