<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated card background, AMBIENT variant: same silhouette as am_card (radius 20dp,
     hairline border) but the fill lets the blurred cover art glow through underneath
     (desktop:the focused tile sits directly on the ambient。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#BF0D1117" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#78232B38" />
</shape>