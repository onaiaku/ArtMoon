<?xml version="1.0" encoding="utf-8"?>
<!-- Stop pill with desktop FocusFrame ring when focused/selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
                <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="#161C26" />
                    <corners android:radius="16dp" />
                    <stroke android:width="3dp" android:color="#FF3D7BFF" />
                </shape>
                </item>
                <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="#161C26" />
                    <corners android:radius="16dp" />
                    <stroke android:width="3dp" android:color="#FF3D7BFF" />
                </shape>
                </item>
                <item>
                <shape android:shape="rectangle">
                    <solid android:color="#161C26" />
                    <corners android:radius="16dp" />
                    <stroke android:width='1dp' android:color='#80E74C3C' />
                </shape>
                </item>
</selector>
