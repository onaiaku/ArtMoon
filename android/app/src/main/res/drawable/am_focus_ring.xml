<?xml version="1.0" encoding="utf-8"?>
<!--
    Gamepad focus highlight — desktop FocusFrame grammar:
    solid 3dp accent ring around whatever has it. Driven by BOTH view focus
    and the activated state (adapters set activated on the focused row, the
    same deterministic path the desktop uses with focusZone/actionIndex,
    instead of trusting drawable state propagation inside AbsListView).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#FF3D7BFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#FF3D7BFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
