<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary pill button (soft accent fill + border). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/am_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/am_accent_soft" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/am_border_high" />
        </shape>
    </item>
</ripple>
