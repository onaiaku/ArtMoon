<?xml version="1.0" encoding="utf-8"?>
<!--
  JetBrains Mono — theme.cpp: Theme.monoFamily.

  Kept for exactly one job: the pairing PIN. Four digits that exist to be read off one
  screen and compared against another, where a 1 that looks like an l is precisely the
  failure a monospaced face prevents. Everywhere else the column alignment comes from the
  layout, so the proportional face is correct.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/jetbrainsmono_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/jetbrainsmono_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
</font-family>
