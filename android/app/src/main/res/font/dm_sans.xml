<?xml version="1.0" encoding="utf-8"?>
<!--
  DM Sans — the desktop's family (theme.cpp: Theme.family = "DM Sans").
  The three TTFs beside this file are byte-identical copies of the ones the desktop
  ships in app/res/fonts/, so the letterforms are the same letterforms.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/dmsans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/dmsans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/dmsans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
</font-family>
