<?xml version="1.0" encoding="utf-8"?>
<!--
    The app picker — the desktop's page (AppsScreen.qml), built as its own screen.

    This is NOT the old app list with new code pasted over it. The old master-detail screen is left
    where it is and this replaces it as the page: same grammar as Home — one thing in the spotlight,
    everything else in a strip, one navigation zone, and the action row saying what A will do.

    The two columns, in the desktop's own proportions (AppsScreen.qml §3):
      · library 52% of what is left after the side margins — the only zone the pad walks
      · hero 48% — the spotlight, mouse-only buttons, drawn with their glyphs

    Sizes here are Android dp read off the desktop's unit scale for a phone in landscape; where a
    number differs from the desktop it is because dp and the desktop's units are not the same ruler,
    and the fraction is what was matched, not the count.

    Ids are the desktop's names so the two can be read side by side: appsHeader, cfgLine, libraryTabs,
    appGrid, hero, heroFacts, heroActions.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ground">

    <!-- CoverAmbient: the focused cover, blurred, behind everything (§18). -->
    <ImageView
        android:id="@+id/am_page_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/am_ambient_veil" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── appsHeader ─────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/appsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingLeft="20dp"
            android:paddingEnd="20dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/am_brand"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/am_brand"
                android:contentDescription="ArtMoon" />

            <TextView
                android:id="@+id/am_host_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/am_text_primary" />

            <!-- The chips: Online, profile, Tailscale, link state. Nothing green except Online. -->
            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/am_chip_online"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/am_chip_online" />

                <TextView
                    android:id="@+id/am_chip_profile"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/am_chip_tailscale"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/am_chip_link"
                    style="@style/AmSpecChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/am_back"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:minHeight="48dp"
                android:background="@drawable/am_pill_soft"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/am_back" />
        </LinearLayout>

        <!-- ── cfgLine: the effective config, in two labelled groups (§17) ─────────────── -->
        <LinearLayout
            android:id="@+id/cfgLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingLeft="20dp"
            android:paddingEnd="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/am_cfg_host_label"
                style="@style/AmCfgLabel"
                android:text="@string/am_cfg_host" />

            <TextView
                android:id="@+id/am_cfg_host"
                style="@style/AmCfgChip"
                android:layout_marginStart="0dp"
                android:layout_marginLeft="0dp" />

            <TextView
                android:id="@+id/am_cfg_host_speed"
                style="@style/AmCfgChip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/am_cfg_sep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginRight="12dp"
                android:text="·"
                android:textColor="@color/am_text2" />

            <TextView
                android:id="@+id/am_cfg_stream_label"
                style="@style/AmCfgLabel"
                android:text="@string/am_cfg_stream" />

            <!-- One pill per setting, built in fillConfigLine — the desktop's Repeater. -->
            <LinearLayout
                android:id="@+id/am_cfg_stream_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false" />
        </LinearLayout>

        <!-- ── the two columns ───────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingLeft="20dp"
            android:paddingEnd="20dp"
            android:paddingRight="20dp">

            <!-- ── the library: the only zone (§12) ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.52"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/libraryTabs"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:paddingBottom="6dp">

                    <!-- The shoulders sit at the two ends of the tabs, as they do on the desktop
                         (AppsScreen.qml:1226 — ProfileShoulder at each end of the strip). With a pad
                         the chip reads LB/RB, with a keyboard PgUp/PgDn: each is drawn beside what
                         it moves. Tapping one moves a tab, which is also how a finger does it. -->
                    <FrameLayout
                        android:id="@+id/am_tab_sh_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:minHeight="30dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginRight="10dp"
                        android:clickable="true"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/am_tab_sh_left_cap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:minWidth="24dp"
                            android:minHeight="24dp"
                            android:text="@string/am_key_pgup"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/am_text"
                            android:background="@drawable/am_action_cap"
                            android:paddingStart="7dp" android:paddingLeft="7dp"
                            android:paddingEnd="7dp" android:paddingRight="7dp"
                            android:alpha="0.85" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/am_tab_all"
                        style="@style/AmTab"
                        android:background="@drawable/am_tab_underline"
                        android:text="@string/am_tab_all" />

                    <TextView
                        android:id="@+id/am_tab_games"
                        style="@style/AmTab"
                        android:background="@drawable/am_tab_underline"
                        android:text="@string/am_tab_games" />

                    <TextView
                        android:id="@+id/am_tab_apps"
                        style="@style/AmTab"
                        android:background="@drawable/am_tab_underline"
                        android:text="@string/am_tab_apps" />

                    <FrameLayout
                        android:id="@+id/am_tab_sh_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="44dp"
                        android:minHeight="30dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginLeft="10dp"
                        android:clickable="true"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/am_tab_sh_right_cap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:minWidth="24dp"
                            android:minHeight="24dp"
                            android:text="@string/am_key_pgdn"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/am_text"
                            android:background="@drawable/am_action_cap"
                            android:paddingStart="7dp" android:paddingLeft="7dp"
                            android:paddingEnd="7dp" android:paddingRight="7dp"
                            android:alpha="0.85" />
                    </FrameLayout>
                </LinearLayout>

                <!-- The list runs the full height of the page — that is where the rows come from. -->
                <ListView
                    android:id="@+id/appGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/am_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="@color/am_text2" />
            </LinearLayout>

            <!-- ── the spotlight: hero + heroFacts + heroActions (§11) ──────────────── -->
            <LinearLayout
                android:id="@+id/hero"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.48"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:orientation="vertical"
                android:gravity="center">

                <!--
                    ⚠️ WEIGHTED, not a fixed 225dp — the cover is the one thing here that gives up
                    room, and it is the desktop's own rule for it (GameFacts.qml:147):
                    `coverHeight = availableHeight - textCol.implicitHeight - _px(18)`, "MEASURED,
                    not estimated, so a title that wraps to three lines shortens the picture instead
                    of pushing the figures off the bottom of the card".

                    It was a fixed height, and the spotlight did not fit: with the playtime line
                    showing the stack needed 892px in an 853px column, so LinearLayout took the
                    shortfall out of the LAST child — the action row — and drew the two pills 40px
                    tall instead of 79px. The keycap inside followed it down, and a compound
                    drawable stretches to the box it is given, so the 63x63 button art came out
                    63x32: both glyphs sliced into half-discs, top and bottom (Nik, 12 Oct 2026:
                    "the buttons only get cut off when it has session stats... it's a space issue,
                    not a button size issue"). Without the figures line there was room, which is
                    why an unplayed game looked right.

                    A weighted child is measured AFTER the others, so nothing below it can ever be
                    squeezed again — a second line in the title shrinks the picture too.
                -->
                <ImageView
                    android:id="@+id/am_hero_cover"
                    android:layout_width="150dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/am_pick_cover_desc" />

                <TextView
                    android:id="@+id/am_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/am_text_primary"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- "running now" · "custom settings" — green when running, else text2 (§11). -->
                <TextView
                    android:id="@+id/am_hero_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textColor="@color/am_text2"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Playtime and session count. Empty on the APPS tab (§6). -->
                <TextView
                    android:id="@+id/am_hero_figures"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="@color/am_text_primary"
                    android:gravity="center"
                    android:visibility="gone" />

                <!--
                    The action row. Drawn, clickable, deliberately outside the focus chain: every one
                    of these already has a face button, so the pad has nothing to walk to and the
                    glyph says which. None of them carries an accent fill — in this interface an
                    accent fill means "the focus is here".
                -->
                <LinearLayout
                    android:id="@+id/heroActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- The pill is the desktop's (radius 9, #0dffffff, hairline border) and it
                         was already there — what was missing is the button inside it. The desktop
                         draws an ActionHint in every one of these (AppsScreen.qml:1141): A with a
                         pad, Enter with a keyboard, X to stop. -->
                    <FrameLayout
                        android:id="@+id/am_hero_launch_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="9dp"
                        android:layout_marginRight="9dp"
                        android:background="@drawable/am_hero_btn"
                        android:clickable="true"
                        android:focusable="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="13dp" android:paddingLeft="13dp"
                            android:paddingEnd="13dp" android:paddingRight="13dp">

                            <TextView
                                android:id="@+id/am_hero_launch_cap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="9dp"
                                android:layout_marginRight="9dp"
                                android:minWidth="24dp"
                                android:minHeight="24dp"
                                android:gravity="center"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/am_text"
                                android:background="@drawable/am_action_cap"
                                android:paddingStart="7dp" android:paddingLeft="7dp"
                                android:paddingEnd="7dp" android:paddingRight="7dp"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/am_hero_launch"
                                style="@style/AmHeroBtn"
                                android:background="@null"
                                android:layout_marginEnd="0dp"
                                android:layout_marginRight="0dp"
                                android:paddingStart="0dp" android:paddingLeft="0dp"
                                android:paddingEnd="0dp" android:paddingRight="0dp" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/am_hero_stop_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/am_hero_btn"
                        android:clickable="true"
                        android:focusable="false"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="13dp" android:paddingLeft="13dp"
                            android:paddingEnd="13dp" android:paddingRight="13dp">

                            <TextView
                                android:id="@+id/am_hero_stop_cap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="9dp"
                                android:layout_marginRight="9dp"
                                android:minWidth="24dp"
                                android:minHeight="24dp"
                                android:gravity="center"
                                android:text="X"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/am_danger"
                                android:background="@drawable/am_action_cap"
                                android:paddingStart="7dp" android:paddingLeft="7dp"
                                android:paddingEnd="7dp" android:paddingRight="7dp"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/am_hero_stop"
                                style="@style/AmHeroBtn"
                                android:background="@null"
                                android:text="@string/am_hero_stop"
                                android:textColor="@color/am_danger"
                                android:layout_marginEnd="0dp"
                                android:layout_marginRight="0dp"
                                android:paddingStart="0dp" android:paddingLeft="0dp"
                                android:paddingEnd="0dp" android:paddingRight="0dp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── the keys, as on every other page ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/am_page_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingLeft="20dp"
            android:paddingEnd="20dp"
            android:paddingRight="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp">

            <!-- Settings and Hosts, as a keycap beside its name — the pair the shared PromptBar
                 draws a real pad glyph into when a controller is in the hand (Y/S and B/Esc, the
                 desktop's own Apps bar: AppShell.qml _hintsApps). This row used to be one string
                 reading "S  Settings": the keyboard half of the prompt, with the pad half missing
                 and no room to draw it. A and X are not here, for the desktop's reason — they are
                 already drawn on the hero's own buttons next to the words for what they do
                 (AppShell.qml:519-527). -->
            <LinearLayout
                android:id="@+id/am_pill_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="false">

                <TextView
                    android:id="@+id/am_key_settings_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:gravity="center"
                    android:text="@string/am_key_s"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/am_text"
                    android:background="@drawable/am_action_cap"
                    android:paddingStart="7dp" android:paddingLeft="7dp"
                    android:paddingEnd="7dp" android:paddingRight="7dp"
                    android:alpha="0.85" />

                <TextView
                    android:id="@+id/am_key_settings"
                    style="@style/AmKeyHint"
                    android:layout_marginEnd="0dp"
                    android:layout_marginRight="0dp"
                    android:text="@string/am_footer_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/am_pill_hosts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="false">

                <TextView
                    android:id="@+id/am_key_hosts_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:gravity="center"
                    android:text="@string/am_key_esc"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/am_text"
                    android:background="@drawable/am_action_cap"
                    android:paddingStart="7dp" android:paddingLeft="7dp"
                    android:paddingEnd="7dp" android:paddingRight="7dp"
                    android:alpha="0.85" />

                <TextView
                    android:id="@+id/am_key_hosts"
                    style="@style/AmKeyHint"
                    android:layout_marginEnd="0dp"
                    android:layout_marginRight="0dp"
                    android:text="@string/am_label_hosts" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
