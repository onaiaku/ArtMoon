<?xml version="1.0" encoding="utf-8"?>
<!-- Compact variant of the ArtMoon app list row (small-icon mode). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/am_card"
    android:foreground="@drawable/am_focus_ring"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:paddingStart="10dp"
    android:paddingLeft="10dp"
    android:paddingEnd="14dp"
    android:paddingRight="14dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/am_cover_frame">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:cropToPadding="true" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginLeft="12dp"
        android:textSize="14sp"
        android:textColor="@color/am_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/am_store_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginLeft="6dp"
        android:background="@drawable/am_badge"
        android:paddingStart="6dp"
        android:paddingLeft="6dp"
        android:paddingEnd="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/am_text_secondary"
        android:maxLines="1"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="18sp"
        android:textColor="@color/am_text_tertiary" />
</LinearLayout>
