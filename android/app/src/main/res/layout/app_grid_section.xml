<?xml version="1.0" encoding="utf-8"?>
<!--
    A section heading in the library list — LAST PLAYED, PINNED, ALL GAMES, ALL APPS, ALL.

    The heading is a row in the same list as the entries, so it scrolls with them and belongs to
    them: a heading pinned to the top of the page would say nothing about the rows below it.
    The rule above is suppressed for the first heading in the list (the adapter hides it), which
    is what stops the page opening on a line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingLeft="12dp"
    android:paddingEnd="12dp"
    android:paddingRight="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/am_section_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:background="@color/am_line" />

    <TextView
        android:id="@+id/am_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        android:textColor="@color/am_text3"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
