<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon main screen — the STAGE. Ported from app/gui/, not designed here.

    Nik's rule (2026-10-12): "If its user facing it needs to look like every other platform,
    meaning we port over what we already have, we dont reinvent the wheel."

    Structure, from the QML and nothing else:
      HomeScreen.qml:1975  HostStage fills below the tab strip — top _px(14), sides _px(44),
                           bottom _px(18).
      HostStage.qml:555    the card is `width: stage._cardW`, and HostStage.qml:280 defines
                           _cardW = round(width * 0.55). It is the LEFT 55%, not a full-bleed
                           card. The right 45% is GameFacts (_px(58) action buttons under it).
      HostStage.qml:863    nameBlock — top _px(20), left _px(38); name at 68 Bold, tracking
                           -2.4*u; sub-line at Theme.fontTitle (19).
      HostStage.qml:1121   fieldRow — top _px(32) below the identity block, spacing _px(32).

    EVERY dimension in this file is the QML's BASE number, unscaled — 44, 14, 18, 38, 20, 68,
    19, 32. AmScale.applyTo() multiplies them by Theme.uiScale (width / 1330) at bind time,
    which is the desktop's own _px(). Do not tidy these into tuned dp: a literal that happens
    to match by luck is drift the moment the window changes width.

    Gone from the old card, because the desktop does not have them: the 56sp fixed title, the
    second HOST LINK block, and the full-bleed hero background.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/am_hero_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="44dp"
    android:layout_marginEnd="44dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ══════ the card — 55%, radius 16, backdrop inside ══════ -->
        <FrameLayout
            android:id="@+id/am_stage_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:background="@drawable/am_stage_card"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/am_hero_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/am_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="38dp"
                android:paddingLeft="38dp"
                android:paddingEnd="38dp"
                android:paddingRight="38dp"
                android:paddingTop="20dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:id="@+id/am_badge_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/am_hero_badge"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp">

                        <View
                            android:id="@+id/status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/am_dot_pairing"
                            android:layout_marginEnd="7dp" />

                        <TextView
                            android:id="@+id/status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.07"
                            android:textAllCaps="true"
                            android:textColor="@color/am_text2"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/am_auth_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="9dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/am_hero_badge"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/am_dot_auth"
                            android:layout_marginEnd="7dp" />

                        <TextView
                            android:id="@+id/am_auth_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/am_hero_auth"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.07"
                            android:textAllCaps="true"
                            android:textColor="@color/am_text2"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- HostStage.qml:896 — the host name, 68 Bold, tracking -2.4u -->
                <TextView
                    android:id="@+id/grid_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="68sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.035"
                    android:textColor="@color/am_text"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- HostStage.qml:1055 — _subLine at Theme.fontTitle (19) -->
                <TextView
                    android:id="@+id/am_ready_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="19sp"
                    android:textColor="@color/am_text2"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- HostStage.qml:1080-1098 — chips, radius _px(7), fontSmall (13) -->
                <LinearLayout
                    android:id="@+id/am_spec_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/am_spec_res" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_fps" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_bitrate" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_codec" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_audio" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                </LinearLayout>

                <!-- HostStage.qml:1121 — fieldRow, _px(32) below the identity block -->
                <LinearLayout
                    android:id="@+id/am_hostlink_block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/am_host_link"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.09"
                        android:textAllCaps="true"
                        android:textColor="@color/am_text3" />

                    <TextView
                        android:id="@+id/am_hostlink_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_text" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- HostStage.qml:1402-1567 — the action row at the card's foot -->
                <LinearLayout
                    android:id="@+id/am_action_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/am_action_open"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="@string/am_action_open"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_on_accent"
                        android:background="@drawable/am_pill_accent_sel"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/am_action_options"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="@string/am_action_options"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_text"
                        android:background="@drawable/am_pill_soft_sel"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ══════ the right 45% — GameFacts / LAST SESSION ══════ -->
        <FrameLayout
            android:id="@+id/am_stage_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45">

            <LinearLayout
                android:id="@+id/am_stats_col"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:id="@+id/am_last_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/am_last_session_when"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/am_last_session"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.09"
                        android:textAllCaps="true"
                        android:textColor="@color/am_text3" />

                    <TextView
                        android:id="@+id/am_last_session_grade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_online"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="34dp">
                            <TextView android:id="@+id/am_last_session_rtt"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="46sp" android:textStyle="bold"
                                android:textColor="@color/am_text" />
                            <TextView android:id="@+id/am_last_session_rtt_caption"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/am_stat_rtt" android:textSize="14sp"
                                android:textStyle="bold" android:letterSpacing="0.09"
                                android:textAllCaps="true" android:textColor="@color/am_text3" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="34dp">
                            <TextView android:id="@+id/am_last_session_hostlat"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="46sp" android:textStyle="bold"
                                android:textColor="@color/am_text" />
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/am_stat_hostlat" android:textSize="14sp"
                                android:textStyle="bold" android:letterSpacing="0.09"
                                android:textAllCaps="true" android:textColor="@color/am_text3" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <TextView android:id="@+id/am_last_session_drops"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="46sp" android:textStyle="bold"
                                android:textColor="@color/am_text" />
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/am_stat_drops" android:textSize="14sp"
                                android:textStyle="bold" android:letterSpacing="0.09"
                                android:textAllCaps="true" android:textColor="@color/am_text3" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/am_last_session_covers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <FrameLayout android:id="@+id/am_last_session_cover0"
                            android:layout_width="48dp" android:layout_height="72dp"
                            android:background="@drawable/am_game_tile" android:layout_marginEnd="8dp">
                            <ImageView android:id="@+id/am_last_session_cover_img0"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:scaleType="centerCrop" android:contentDescription="@null"
                                android:visibility="gone" />
                            <TextView android:id="@+id/am_last_session_cover_name0"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:padding="4dp" android:textSize="9sp"
                                android:textColor="@color/am_text2" android:maxLines="3"
                                android:ellipsize="end" />
                        </FrameLayout>

                        <FrameLayout android:id="@+id/am_last_session_cover1"
                            android:layout_width="48dp" android:layout_height="72dp"
                            android:background="@drawable/am_game_tile" android:layout_marginEnd="8dp">
                            <ImageView android:id="@+id/am_last_session_cover_img1"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:scaleType="centerCrop" android:contentDescription="@null"
                                android:visibility="gone" />
                            <TextView android:id="@+id/am_last_session_cover_name1"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:padding="4dp" android:textSize="9sp"
                                android:textColor="@color/am_text2" android:maxLines="3"
                                android:ellipsize="end" />
                        </FrameLayout>

                        <FrameLayout android:id="@+id/am_last_session_cover2"
                            android:layout_width="48dp" android:layout_height="72dp"
                            android:background="@drawable/am_game_tile" android:layout_marginEnd="8dp">
                            <ImageView android:id="@+id/am_last_session_cover_img2"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:scaleType="centerCrop" android:contentDescription="@null"
                                android:visibility="gone" />
                            <TextView android:id="@+id/am_last_session_cover_name2"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:padding="4dp" android:textSize="9sp"
                                android:textColor="@color/am_text2" android:maxLines="3"
                                android:ellipsize="end" />
                        </FrameLayout>

                        <TextView android:id="@+id/am_last_session_more"
                            android:layout_width="wrap_content" android:layout_height="match_parent"
                            android:gravity="center|end" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/am_text2"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- kept so the adapter's existing binding keeps working; the desktop has no
                 glyph well on the stage, so it stays gone unless there is something to say -->
            <FrameLayout
                android:id="@+id/am_glyph_well"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.55"
                android:visibility="gone">

                <ImageView android:id="@+id/grid_image"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:scaleType="fitCenter" />

                <ImageView android:id="@+id/grid_overlay"
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" android:scaleType="fitCenter" />

                <ProgressBar android:id="@+id/grid_spinner"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_gravity="center" android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
