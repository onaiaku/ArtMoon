<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon main screen — the STAGE. Ported from app/gui/, not designed here.

    Nik's rule (2026-10-12): "If its user facing it needs to look like every other platform,
    meaning we port over what we already have, we dont reinvent the wheel."

    Structure, from the QML and nothing else:
      HomeScreen.qml:1975  HostStage fills below the tab strip — top _px(14), sides _px(44),
                           bottom _px(18).
      HostStage.qml:555    the card is `width: stage._cardW`, and HostStage.qml:280 defines
                           _cardW = round(width * 0.55). It is the LEFT 55%, not a full-bleed
                           card. The right 45% is GameFacts (_px(58) action buttons under it).
      HostStage.qml:863    nameBlock — top _px(20), left _px(38); name at 68 Bold, tracking
                           -2.4*u; sub-line at Theme.fontTitle (19).
      HostStage.qml:1121   fieldRow — top _px(32) below the identity block, spacing _px(32).

    EVERY dimension in this file is the QML's BASE number, unscaled — 44, 14, 18, 38, 20, 68,
    19, 32. AmScale.applyTo() multiplies them by Theme.uiScale (width / 1330) at bind time,
    which is the desktop's own _px(). Do not tidy these into tuned dp: a literal that happens
    to match by luck is drift the moment the window changes width.

    Gone from the old card, because the desktop does not have them: the 56sp fixed title, the
    second HOST LINK block, and the full-bleed hero background.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/am_hero_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="44dp"
    android:layout_marginEnd="44dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ══════ the card — 55%, radius 16, backdrop inside ══════ -->
        <FrameLayout
            android:id="@+id/am_stage_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:background="@drawable/am_stage_card"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/am_hero_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/am_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="38dp"
                android:paddingLeft="38dp"
                android:paddingEnd="38dp"
                android:paddingRight="38dp"
                android:paddingTop="20dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:id="@+id/am_badge_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/am_hero_badge"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp">

                        <View
                            android:id="@+id/status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/am_dot_pairing"
                            android:layout_marginEnd="7dp" />

                        <TextView
                            android:id="@+id/status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.07"
                            android:textAllCaps="true"
                            android:textColor="@color/am_text2"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/am_auth_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="9dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/am_hero_badge"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/am_dot_auth"
                            android:layout_marginEnd="7dp" />

                        <TextView
                            android:id="@+id/am_auth_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/am_hero_auth"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.07"
                            android:textAllCaps="true"
                            android:textColor="@color/am_text2"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- HostStage.qml:896 — the host name, 68 Bold, tracking -2.4u -->
                <TextView
                    android:id="@+id/grid_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="68sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.035"
                    android:textColor="@color/am_text"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- HostStage.qml:1055 — _subLine at Theme.fontTitle (19) -->
                <TextView
                    android:id="@+id/am_ready_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="19sp"
                    android:textColor="@color/am_text2"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- HostStage.qml:1080-1098 — chips, radius _px(7), fontSmall (13) -->
                <LinearLayout
                    android:id="@+id/am_spec_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/am_spec_res" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_fps" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_bitrate" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_codec" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                    <TextView android:id="@+id/am_spec_audio" style="@style/AmSpecChip"
                        android:layout_width="wrap_content" android:layout_height="28dp" />
                </LinearLayout>

                <!-- HostStage.qml:1121 — fieldRow, _px(32) below the identity block -->
                <LinearLayout
                    android:id="@+id/am_hostlink_block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/am_host_link"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.09"
                        android:textAllCaps="true"
                        android:textColor="@color/am_text3" />

                    <TextView
                        android:id="@+id/am_hostlink_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_text" />
                </LinearLayout>

            <LinearLayout
                android:layout_marginStart="38dp"
                android:layout_marginLeft="38dp"
                android:layout_marginEnd="38dp"
                android:layout_marginRight="38dp"
                android:layout_marginTop="28dp"
                android:id="@+id/am_last_session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/am_last_session_when"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/am_last_session"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09"
                    android:textAllCaps="true"
                    android:textColor="@color/am_text3" />

                <TextView
                    android:id="@+id/am_last_session_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/am_online"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="34dp">
                        <TextView android:id="@+id/am_last_session_rtt"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="46sp" android:textStyle="bold"
                            android:textColor="@color/am_text" />
                        <TextView android:id="@+id/am_last_session_rtt_caption"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/am_stat_rtt" android:textSize="14sp"
                            android:textStyle="bold" android:letterSpacing="0.09"
                            android:textAllCaps="true" android:textColor="@color/am_text3" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="34dp">
                        <TextView android:id="@+id/am_last_session_hostlat"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="46sp" android:textStyle="bold"
                            android:textColor="@color/am_text" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/am_stat_hostlat" android:textSize="14sp"
                            android:textStyle="bold" android:letterSpacing="0.09"
                            android:textAllCaps="true" android:textColor="@color/am_text3" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView android:id="@+id/am_last_session_drops"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="46sp" android:textStyle="bold"
                            android:textColor="@color/am_text" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/am_stat_drops" android:textSize="14sp"
                            android:textStyle="bold" android:letterSpacing="0.09"
                            android:textAllCaps="true" android:textColor="@color/am_text3" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/am_last_session_covers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <FrameLayout android:id="@+id/am_last_session_cover0"
                        android:layout_width="48dp" android:layout_height="72dp"
                        android:background="@drawable/am_game_tile" android:layout_marginEnd="8dp">
                        <ImageView android:id="@+id/am_last_session_cover_img0"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:contentDescription="@null"
                            android:visibility="gone" />
                        <TextView android:id="@+id/am_last_session_cover_name0"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:padding="4dp" android:textSize="9sp"
                            android:textColor="@color/am_text2" android:maxLines="3"
                            android:ellipsize="end" />
                    </FrameLayout>

                    <FrameLayout android:id="@+id/am_last_session_cover1"
                        android:layout_width="48dp" android:layout_height="72dp"
                        android:background="@drawable/am_game_tile" android:layout_marginEnd="8dp">
                        <ImageView android:id="@+id/am_last_session_cover_img1"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:contentDescription="@null"
                            android:visibility="gone" />
                        <TextView android:id="@+id/am_last_session_cover_name1"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:padding="4dp" android:textSize="9sp"
                            android:textColor="@color/am_text2" android:maxLines="3"
                            android:ellipsize="end" />
                    </FrameLayout>

                    <FrameLayout android:id="@+id/am_last_session_cover2"
                        android:layout_width="48dp" android:layout_height="72dp"
                        android:background="@drawable/am_game_tile" android:layout_marginEnd="8dp">
                        <ImageView android:id="@+id/am_last_session_cover_img2"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:contentDescription="@null"
                            android:visibility="gone" />
                        <TextView android:id="@+id/am_last_session_cover_name2"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:padding="4dp" android:textSize="9sp"
                            android:textColor="@color/am_text2" android:maxLines="3"
                            android:ellipsize="end" />
                    </FrameLayout>

                    <TextView android:id="@+id/am_last_session_more"
                        android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center|end" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/am_text2"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- HostStage.qml:1402-1567 — the action row at the card's foot -->
                <LinearLayout
                    android:id="@+id/am_action_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/am_action_open"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="@string/am_action_open"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_on_accent"
                        android:background="@drawable/am_pill_accent_sel"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/am_action_options"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="@string/am_action_options"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_text"
                        android:background="@drawable/am_pill_soft_sel"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ══════ the right 45% — GameFacts / LAST SESSION ══════ -->
        <FrameLayout
            android:id="@+id/am_stage_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45">

        <!-- ══════ the right column — GameFacts (app/gui/GameFacts.qml) ══════

             This is what the desktop puts beside the card, and it is NOT the host's session
             numbers. Since 5.6.1 the host's own LASTSESSION reply is no longer what Home shows
             here (HostStage.qml:1600): the block describes what you played, and "the layout is
             GameFacts, the same component the host page's spotlight uses ... Do not
             re-implement it here" (HostStage.qml:1606-1609).

             It is what Nik was looking for on the right. Its absence is why the right-hand side
             of the phone read as empty: the panel existed but held only the numbers block, which
             is hidden unless the host reports a session, so with nothing to report the whole 45%
             drew nothing at all.

             Geometry, from GameFacts.qml, every number BASE and scaled by AmScale:
               165  column spacing _px(18)
               170  badge _px(30) tall, radius _px(6), width = content + _px(26)
               180  badge inner spacing _px(9); dot _px(8)
               206  badge texts at Theme.fontBody (16)
               226  cover radius _px(10), height from availableHeight at bind time
               250  title column, spacing _px(4); title at Theme.fontDisplay (34) Bold
               320  meta row, spacing _px(8); store mark _px(19); text Theme.fontBody
               368  spacer _px(12), drawn only when the figures are
               381  figures spacing _px(30); value Theme.fontH2 (23), caption Theme.fontCaption (11)

             The block is pinned to the panel's right edge with the desktop's own margin —
             right _px(46), top _px(30) (HostStage.qml:1630-1633) — so `paddingEnd` stands in for
             the end margin and every child centres inside what is left, which is how GameFacts
             lays itself out (horizontalCenter on the badge, cover, title, meta and figures).

             An empty map draws nothing at all — there is no empty state
             (HostStage.qml:1611-1613). -->
        <LinearLayout
            android:id="@+id/am_facts_col"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="30dp"
            android:paddingEnd="46dp"
            android:paddingRight="46dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/am_facts_badge"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/am_badge"
                android:paddingStart="13dp"
                android:paddingLeft="13dp"
                android:paddingEnd="13dp"
                android:paddingRight="13dp"
                android:visibility="gone">

                <View
                    android:id="@+id/am_facts_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/am_dot_online" />

                <TextView
                    android:id="@+id/am_facts_badge_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_marginLeft="9dp"
                    android:textSize="16sp"
                    android:textColor="@color/am_text" />

                <TextView
                    android:id="@+id/am_facts_badge_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_marginLeft="9dp"
                    android:textSize="16sp"
                    android:textColor="@color/am_text3" />
            </LinearLayout>

            <ImageView
                android:id="@+id/am_facts_cover"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="18dp"
                android:scaleType="centerCrop"
                android:background="@drawable/am_cover_frame"
                android:clipToOutline="true"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/am_facts_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/am_text" />

            <LinearLayout
                android:id="@+id/am_facts_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/am_facts_meta_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/am_facts_meta_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/am_text2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/am_facts_figures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/am_facts_played"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_text" />

                    <TextView
                        android:id="@+id/am_facts_played_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/am_fig_played"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textAllCaps="true"
                        android:textColor="@color/am_text3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginLeft="30dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/am_facts_sessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="@color/am_text" />

                    <TextView
                        android:id="@+id/am_facts_sessions_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/am_fig_sessions"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textAllCaps="true"
                        android:textColor="@color/am_text3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


            <!-- kept so the adapter's existing binding keeps working; the desktop has no
                 glyph well on the stage, so it stays gone unless there is something to say -->
            <FrameLayout
                android:id="@+id/am_glyph_well"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.55"
                android:visibility="gone">

                <ImageView android:id="@+id/grid_image"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:scaleType="fitCenter" />

                <ImageView android:id="@+id/grid_overlay"
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" android:scaleType="fitCenter" />

                <ProgressBar android:id="@+id/grid_spinner"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_gravity="center" android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
