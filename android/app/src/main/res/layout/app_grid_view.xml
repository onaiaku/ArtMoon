<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon app picker, PORTRAIT — the same list as landscape, one column wide: the tab row on
    top and the library under it, section headings scrolling with their rows. The detail panel
    landscape carries beside the list has nowhere to go here, so a tap acts on the row directly.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/am_ground">

        <!-- The three tabs, as the desktop has them: a pill each, the count inside the label,
             opening on the host's saved tab. -->
        <LinearLayout
            android:id="@+id/am_pick_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="14dp"
            android:paddingLeft="14dp"
            android:paddingEnd="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/am_tab_all"
                style="@style/AmTab" />

            <TextView
                android:id="@+id/am_tab_games"
                style="@style/AmTab" />

            <TextView
                android:id="@+id/am_tab_apps"
                style="@style/AmTab" />
        </LinearLayout>

    <GridView
        android:id="@+id/fragmentView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="1"
        android:stretchMode="columnWidth"
        android:verticalSpacing="4dp"
        android:paddingTop="8dp"
        android:focusable="true"
        android:clipToPadding="false"
        android:gravity="fill_horizontal" />
</LinearLayout>
