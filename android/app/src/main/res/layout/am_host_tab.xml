<?xml version="1.0" encoding="utf-8"?>
<!--
    One host tab, ported from HomeScreen.qml:1883-1943.

    Every dimension here is the QML's BASE number, unscaled — 40 tall, radius 9, 8px dot,
    fontTitle 19, 20 horizontal padding. PcView applies (base * Theme.uiScale) through AmScale
    at bind time, exactly as the desktop does. Do not "tidy" these into tuned dp: a literal that
    matches the desktop by luck is drift the moment the window changes width.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="@drawable/am_picker_pill">

    <!-- Connectivity at a glance (HomeScreen.qml:1909-1919): offline / unknown / online+
         paired / online+unpaired. Never accent-coloured — semantic colours stay semantic. -->
    <View
        android:id="@+id/am_tab_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:background="@drawable/am_dot_offline" />

    <TextView
        android:id="@+id/am_tab_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        android:textColor="@color/am_text_tertiary" />

</LinearLayout>
