<?xml version="1.0" encoding="utf-8"?>
<!--
    ArtMoon main screen — ported from app/gui/HomeScreen.qml and AppShell.qml.

    Nik's rule (2026-10-12): "If its user facing it needs to look like every other platform,
    meaning we port over what we already have, we dont reinvent the wheel."

      HomeScreen.qml:1741-1819  brand row — sides _px(44), top _px(22), height _px(60);
                                icon _px(46); column at +_px(14) with spacing _px(4);
                                ARTMOON at Theme.fontH1 (28) Black, tracking 3.6*u;
                                "Gamestream" at Theme.fontSmall (13) in Theme.text3.
      HomeScreen.qml:1821-1970  tab strip — _px(18) below the brand row, sides _px(44),
                                height _px(44); shoulders at BOTH ENDS, tabs between them
                                (h _px(40), radius _px(9), gap _px(8)); the last tab is
                                "+  Add a host" and the strip pages with the shoulders.
      AppShell.qml              the footer prompts sit bottom-LEFT, not centred.

    Every dimension is the QML's BASE number. AmScale.applyTo() multiplies them by
    Theme.uiScale (width / 1330) — the desktop's own _px() — at bind time.

    Removed: the literal "PgUp"/"PgDn" text pills that used to be the host picker. Those are
    desktop keyboard shortcuts; as buttons they were the clearest sign this screen had been
    built from a screenshot instead of read from the source.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/am_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ground"
    tools:context=".PcView">

    <!--
        The app's floor (desktop 6.0.0): the charcoal wash and the five wave layers that travel
        across it — AmbientBackground.qml + AmbientWaves.qml, ported whole in ui/AmbientFloor.
        First child, so it is the backmost thing on the screen; the stage in front of it carries
        no background of its own, which is what lets the floor show in the margins the desktop
        shows it in.
    -->
    <io.github.onaiaku.artmoon.ui.AmbientFloor
        android:id="@+id/am_floor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ══════ brand row — 44 sides / 22 top / 60 tall ══════ -->
    <LinearLayout
        android:id="@+id/am_brand_row"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="44dp"
        android:layout_marginLeft="44dp"
        android:layout_marginEnd="44dp"
        android:layout_marginRight="44dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/am_logo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/am_brand"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/am_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/am_wordmark"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.1286"
                android:textAllCaps="true"
                android:textColor="@color/am_text" />

            <TextView
                android:id="@+id/am_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/am_tagline"
                android:textSize="13sp"
                android:textColor="@color/am_text3" />
        </LinearLayout>

        <!-- Keeps the brand at the left and lets the cluster take the corner. -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- ══════ clock cluster — AppShell.qml:454 + StatusCluster.qml ══════

             The desktop instantiates StatusCluster once, in AppShell, and no page draws its own:
             anchored _px(22) from the top and _px(44) from the right — the same 44/22 this row
             already carries, which is the whole reason it lands here. Its own note says the size
             has to sit "against the wordmark opposite", and that is exactly what it is opposite
             of.

             Two lines, and the second is the quiet one: the clock is what you look at, the date
             under it is the surround (StatusCluster.qml:15-22). No battery chip: that is
             PowerStatus, which the port does not have, and it only appears on a device that has
             one anyway. -->
        <LinearLayout
            android:id="@+id/am_clock_cluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Theme.fontH1, Medium, Theme.text (StatusCluster.qml:63-74). sans-serif-medium is
                 Android's own Medium — the same weight, without pinning a font-weight attribute
                 that only exists above API 28. -->
            <TextView
                android:id="@+id/am_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textColor="@color/am_text"
                android:fontFamily="sans-serif-medium"
                tools:text="21:04" />

            <!-- Theme.fontSmall, Theme.text3. -->
            <TextView
                android:id="@+id/am_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/am_text3"
                tools:text="13/10/2026" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ tab strip — HomeScreen.qml:1824-1970 ══════

         One Row, anchored LEFT, and that is the whole point: the desktop does not spread the
         strip across the screen. Its shoulders sit at the ENDS OF THE STRIP — LT, then the tabs,
         then RT, spacing _px(14) between the three groups and _px(8) between tabs — so with two
         hosts the two shoulders are two tabs' width apart, not one at each edge of the panel.
         Spreading them (the HorizontalScrollView with layout_weight="1" that was here) is what
         left RT floating on its own at the right-hand side.

         The scroll view is kept, at match_parent, but the row inside it is wrap_content and
         fillViewport is false: a short strip stays left-aligned at its natural width, a strip
         with more hosts than fit scrolls instead of clipping. -->
    <HorizontalScrollView
        android:id="@+id/am_tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@+id/am_brand_row"
        android:layout_marginStart="44dp"
        android:layout_marginLeft="44dp"
        android:layout_marginEnd="44dp"
        android:layout_marginRight="44dp"
        android:layout_marginTop="18dp"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/am_tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left trigger — HomeScreen.qml:1852-1874. Not a pill reading "LT": the desktop
                 puts an ActionHint here at size _px(28) inside a 44x30 item, so what is drawn is
                 the button itself — the key chip ("PgUp") with no pad, the vendor glyph with one.

                 PcView shows/hides the whole box, so the box is what carries the id and the
                 click; the chip inside it is the drawing.

                 ⚠️ BOTH BOXES ARE wrap_content, AND THAT IS THE FIX FOR THE CROPPED "PgUp".
                 ActionHint.qml:79 floors its label at 11 — `Math.max(11, Math.round(size * 0.46))`
                 — and floors it in REAL px, so the floor does not scale down with the window
                 ("the desktop's floor does not move", applyCapLetter's own note). The desktop
                 survives that because an ActionHint SIZES ITSELF around the label it draws: the
                 chip grows and nothing is ever cut.

                 Here the chip was nailed into a 44x30 box. At a desktop width the two agree; on a
                 phone in portrait the box scales to 44 * 0.357 = 16dp wide while the floored label
                 still needs ~26dp, so the frame clipped the word and the shoulder showed one
                 letter. wrap_content with the design size as the MINIMUM is the desktop's own
                 behaviour: the box is never smaller than the design, and never smaller than the
                 label either. -->
            <FrameLayout
                android:id="@+id/am_pg_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:minHeight="30dp"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginEnd="14dp"
                android:layout_marginRight="14dp">

                <TextView
                    android:id="@+id/am_pg_up_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="24dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:minWidth="24dp"
                    android:text="@string/am_key_pgup"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/am_text"
                    android:background="@drawable/am_action_cap"
                    android:paddingStart="7dp" android:paddingLeft="7dp"
                    android:paddingEnd="7dp" android:paddingRight="7dp"
                    android:alpha="0.85" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/am_tab_row"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <!-- Right trigger — the strip's OTHER END, not the screen's: it follows the last
                 tab (HomeScreen.qml:1947-1968). Same wrap_content story as the left one. -->
            <FrameLayout
                android:id="@+id/am_pg_dn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:minHeight="30dp"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginStart="14dp"
                android:layout_marginLeft="14dp">

                <TextView
                    android:id="@+id/am_pg_dn_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="24dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:minWidth="24dp"
                    android:text="@string/am_key_pgdn"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/am_text"
                    android:background="@drawable/am_action_cap"
                    android:paddingStart="7dp" android:paddingLeft="7dp"
                    android:paddingEnd="7dp" android:paddingRight="7dp"
                    android:alpha="0.85" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══════ the stage ══════ -->
    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_below="@+id/am_tab_scroll"
        android:layout_above="@+id/am_footer">

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:layout_centerInParent="true">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/am_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/am_text2"
                android:text="@string/searching_pc"/>
        </RelativeLayout>
    </RelativeLayout>

    <!-- ══════ footer prompts — AppShell.qml:575-621 ══════

         Structurally this is a ROW OF PAIRS, not three pills:

             Row { spacing: _px(20)
               delegate Item {                       // implicitWidth + _px(8) of slack
                 Row { spacing: _px(9)
                   ActionHint { size: _px(26) }      // the button: a key chip, 24 tall, radius 6
                   Text { font.pixelSize: _px(Theme.fontBody); color: Theme.text }
                 }
               }
             }

         ⚠️ The WORD HAS NO BOX. It never did — on no platform, in no mode. The word is
         Theme.text at fontBody and nothing else. What made this read as "three pills" was a
         full-round bordered capsule drawn behind the word; the desktop's only bordered thing
         here is the little key chip in front of it, and that is 24 tall against the word's 16.

         A prompt's width is the pair plus _px(8) of slack, so with _px(20) between them the
         visible gap is 28. Left margin _px(20) (AppShell.qml:578), bar height _px(44)
         (AppShell.qml:470).

         The chips are PromptBar's; it shows/hides and re-skins them per input mode and never
         touches the word. -->
    <LinearLayout
        android:id="@+id/am_footer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingLeft="20dp"
        android:paddingEnd="20dp"
        android:paddingRight="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/am_footer_kb_shutdown"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="24dp"
                android:gravity="center"
                android:text="@string/am_footer_key_p"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/am_text"
                android:background="@drawable/am_action_cap"
                android:paddingStart="7dp" android:paddingLeft="7dp"
                android:paddingEnd="7dp" android:paddingRight="7dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/am_footer_shutdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/am_footer_shutdown"
                android:textSize="16sp"
                android:textColor="@color/am_text"
                android:layout_marginStart="9dp"
                android:layout_marginLeft="9dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginLeft="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/am_footer_kb_settings"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="24dp"
                android:gravity="center"
                android:text="@string/am_footer_key_s"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/am_text"
                android:background="@drawable/am_action_cap"
                android:paddingStart="7dp" android:paddingLeft="7dp"
                android:paddingEnd="7dp" android:paddingRight="7dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/am_footer_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/am_footer_settings"
                android:textSize="16sp"
                android:textColor="@color/am_text"
                android:layout_marginStart="9dp"
                android:layout_marginLeft="9dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginLeft="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/am_footer_kb_exit"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="24dp"
                android:gravity="center"
                android:text="@string/am_footer_key_esc"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/am_text"
                android:background="@drawable/am_action_cap"
                android:paddingStart="7dp" android:paddingLeft="7dp"
                android:paddingEnd="7dp" android:paddingRight="7dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/am_footer_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/am_footer_exit"
                android:textSize="16sp"
                android:textColor="@color/am_text"
                android:layout_marginStart="9dp"
                android:layout_marginLeft="9dp" />
        </LinearLayout>

        <!-- ══════ the client version — AppShell.qml:691-699 ══════

             The desktop's status bar has a right cluster, and the version label is its last item:
             flush right when nothing else is running, and the thing an update chip slots to the
             left of when one is. Same label, same corner.

             "v" + the binary's own version and never a literal: AppShell.qml:49-55 stopped
             hand-bumping one after 5.2.1 shipped a whole release claiming the previous version.
             Here the binary's version is BuildConfig.VERSION_NAME, generated from build.gradle,
             so the label and the APK cannot disagree either.

             PromptBar finds its chips BY ID (artlight/PromptBar.java), so a sibling it does not
             know about is not in its way; the pills keep the left and a weighted spacer is all
             the layout needs to put this on the right. -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Theme.text2, Theme.fontSmall, tracking 1 (written as 1/13 em, per the port's rule). -->
        <TextView
            android:id="@+id/am_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/am_text2"
            android:letterSpacing="0.0769"
            tools:text="v1.9.1" />
    </LinearLayout>


</RelativeLayout>
