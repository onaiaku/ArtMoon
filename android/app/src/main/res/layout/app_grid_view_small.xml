<?xml version="1.0" encoding="utf-8"?>
<!-- Small-icon mode: the same page, compact rows. The tabs sit above the list, as they do on the
     desktop and in the full-size layout — small-icon mode is a row height, not a different page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/am_ground">

        <!-- The three tabs, as the desktop has them: a pill each, the count inside the label,
             opening on the host's saved tab. -->
        <LinearLayout
            android:id="@+id/am_pick_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="14dp"
            android:paddingLeft="14dp"
            android:paddingEnd="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/am_tab_all"
                style="@style/AmTab" />

            <TextView
                android:id="@+id/am_tab_games"
                style="@style/AmTab" />

            <TextView
                android:id="@+id/am_tab_apps"
                style="@style/AmTab" />
        </LinearLayout>

    <GridView
        android:id="@+id/fragmentView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/am_ground"
        android:numColumns="1"
        android:stretchMode="columnWidth"
        android:verticalSpacing="3dp"
        android:paddingTop="8dp"
        android:focusable="true"
        android:clipToPadding="false"
        android:gravity="fill_horizontal"/>
</LinearLayout>
