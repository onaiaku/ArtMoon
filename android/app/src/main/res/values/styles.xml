<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        ArtMoon application theme. The StreamTheme deliberately keeps the transparent
        window background from upstream: extra overdraw behind the video surface is
        wasted frames, and the desktop agrees — the stream view is all video.
    -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/AmAlertDialogTheme</item>
    </style>

    <!--
        AM dialog theme: every AlertDialog in the app (quit confirm, error
        dialogs, context menus on Material) derives from this. Dark ArtMoon
        surface instead of the stock light Android popup.
    -->
    <style name="AmAlertDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/am_dialog_bg</item>
        <item name="android:colorBackground">@color/am_surface</item>
        <item name="android:textColorPrimary">@color/am_text_primary</item>
        <item name="android:textColorSecondary">@color/am_text_secondary</item>
        <item name="android:colorAccent">@color/am_auth</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="StreamTheme" parent="StreamBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        AM settings theme: dark ArtMoon surface for the legacy PreferenceFragment.
        The legacy preference widgets derive every color from these theme attributes,
        so restyling the activity is enough to re-skin the whole screen.
    -->
    <style name="AmSettingsTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/am_ground</item>
        <item name="android:colorBackground">@color/am_ground</item>
        <item name="android:statusBarColor">@color/am_ground</item>
        <item name="android:navigationBarColor">@color/am_ground</item>
        <item name="android:textColorPrimary">@color/am_text_primary</item>
        <item name="android:textColorSecondary">@color/am_text_secondary</item>
        <item name="android:textColorTertiary">@color/am_text_tertiary</item>
        <item name="android:colorAccent">@color/am_auth</item>
        <item name="android:colorControlActivated">@color/am_auth</item>
        <item name="android:colorControlNormal">@color/am_text_tertiary</item>
        <item name="android:colorControlHighlight">@color/am_ripple</item>
        <!-- Category headers: uppercase, tracked-out, dim — matches hero badges. -->
    </style>

    <!-- The stream badges beside the status line. HostStage.qml:1079-1099 —
         height _px(28), radius _px(7), text + _px(20), a 7% wash with a 26% border, text in
         Theme.fontSmall (13) DemiBold in the reading colour, and NO tracking.

         It used to be 10sp bold with 0.06 tracking on a solid @color/am_surface box with a
         12dp radius — a different component wearing the same name. The desktop's badges are a
         tint of the reading colour, not a surface, and at less than half that radius. -->
    <style name="AmSpecChip">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/am_text</item>
        <item name="android:background">@drawable/am_spec_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <!-- The picker's tabs. One style for all three so they cannot drift; the adapter swaps the
         background and the text colour for whichever tab is open. -->
    <style name="AmTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/am_picker_pill</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/am_text2</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
